# Site settings for the multi-event pipeline. Copy to multievent/site.env (not committed) and edit.
#   cp multievent/site.env.example multievent/site.env
# Every numbered script sources multievent/00_env.sh, which reads this file.

# Where everything big goes (data, model output, builds). On gpu-h100 /home is nearly full: use
# /Datastorage there.
export ME_ROOT=/Datastorage/$USER/multievent

# Compilers / MPI / netCDF from the system, if it has them (leave empty to use only what
# 01_install_libraries.sh builds). Examples:
#   export ME_MODULES="gcc/11 openmpi/4.1 netcdf-fortran/4.6"     (Environment Modules / Lmod)
#   export ME_ENV_SCRIPT=$HOME/WRFCHEM/scripts/env_wrfchem.sh      (gpu-h100: the WRF-Chem toolchain)
export ME_MODULES=""
export ME_ENV_SCRIPT=""

# An existing WRF 4.5 build WITH the Thompson fix and an existing WPS 4.5 build may be used
# instead of building new ones (gpu-h100: ~/TWCR/WRF-4.5-thompsonfix). Empty = 02 builds them.
export ME_WRF_DIR=""
export ME_WPS_DIR=""
# WPS static geography. UCAR downloads are blocked on both HPCs: copy it from gpu-h100
# (~/WRFCHEM/WPS_GEOG, rsync -a) to the other machine.
export ME_WPS_GEOG=$HOME/WRFCHEM/WPS_GEOG

# How runs are started: local (background lanes on this node), pbs or slurm (one job per run).
export ME_SCHEDULER=local
export ME_NPROCS=16              # MPI ranks per run
export ME_LANES=4                # local only: runs at the same time (ME_LANES x ME_NPROCS <= cores)
export ME_WALLTIME=24:00:00      # pbs/slurm: wall time per run (a 7-day run needs about 2-6 h on 16 cores)
export ME_PBS_RESOURCES="select=1:ncpus=16:mpiprocs=16"   # PBS Pro; Torque: "nodes=1:ppn=16"
export ME_SCHED_EXTRA=""         # e.g. "-q normal" (pbs) or "--partition=compute --account=xyz" (slurm)
export ME_MPIRUN="mpirun"        # called as "$ME_MPIRUN -n N"; some slurm sites want "srun --mpi=pmi2"

# Optional (defaults shown): resumes per start of a case, minutes without a line in
# rsl.error.0000 before wrf.exe counts as hung, minutes before an unrefreshed lock counts as stale
# export ME_MAX_RESUMES=4 ME_HANG_MIN=90 ME_LOCK_STALE_MIN=30

# Python (03_install_python.sh creates it here unless set)
export ME_PYTHON=""
