! RegCM5 namelist  event=E2_mumbai2005  driver=20CRv3  resolution=12km
! Generated by scripts/generate_namelists.py from config/experiment.yaml. Do not edit.
! Physics follow the RegCM5 CORDEX namelists shipped with the model
! (Testing/CORDEX/EUR-12_RegCM5_ERA5 and EUR-03_RegCM5_ERA5), adapted for nesting.
! DRIVER_DIR and RUN_ROOT are replaced by scripts/run/run_regcm.sh.
! dattyp/ssttyp 'ERA5' is the RegCM ERA5 netCDF reader; for driver=20CRv3 the
! files under DRIVER_DIR/20CRv3/ERA5/ are written by the scripts in scripts/preprocess.
 &dimparam
 iy                               = 242,
 jx                               = 272,
 kz                               = 30,
 /

 &coreparam
 idynamic                         = 3,
 /

 &geoparam
 iproj                            = 'NORMER',
 ds                               = 12.0,
 ptop                             = 5.0,
 clat                             = 15.0,
 clon                             = 76.0,
 /

 &terrainparam
 domname                          = 'E2_mumbai2005_20CRv3_12km',
 h2opct                           = 50.0,
 h2ohgt                           = .false.,
 dirter                           = 'input',
 inpter                           = 'RCMDATA',
 /

 &boundaryparam
 nspgx                            = 20,
 nspgd                            = 20,
 high_nudge                       = 6.0,
 medium_nudge                     = 4.0,
 low_nudge                        = 2.0,
 /

 &globdatparam
 ibdyfrq                          = 3,
 ssttyp                           = 'ERA5',
 dattyp                           = 'ERA5',
 gdate1                           = 2005072400,
 gdate2                           = 2005073000,
 calendar                         = 'gregorian',
 dirglob                          = 'input',
 inpglob                          = 'DRIVER_DIR/20CRv3',
 /

 &restartparam
 ifrest                           = .false.,
 mdate0                           = 2005072400,
 mdate1                           = 2005072400,
 mdate2                           = 2005073000,
 /

 &timeparam
 dt                               = 90.0,
 /

 &outparam
 ifsave                           = .false.,
 ifatm                            = .true.,
 atmfrq                           = 3.0,
 ifrad                            = .false.,
 ifsrf                            = .true.,
 srffrq                           = 1.0,
 ifsts                            = .true.,
 ifshf                            = .true.,
 ifsub                            = .false.,
 iflak                            = .false.,
 ifchem                           = .false.,
 outnwf                           = 0.0,
 dirout                           = 'output',
 /

 &physicsparam
 iboudy                           = 5,
 ibltyp                           = 1,
 icup_lnd                         = 5,
 icup_ocn                         = 5,
 ipptls                           = 2,
 iocnflx                          = 2,
 iocnrough                        = 1,
 iocnzoq                          = 1,
 scenario                         = 'SSP245',
 idcsst                           = 0,
 iseaice                          = 0,
 iconvlwp                         = 0,
 icldfrac                         = 1,
 irrtm                            = 0,
 iclimao3                         = 1,
 isolconst                        = 0,
 iclimaaer                        = 0,
 /

 &cldparam
