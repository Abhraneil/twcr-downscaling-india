#!/usr/bin/env python3
import glob, re
from datetime import datetime, timedelta
import numpy as np, xarray as xr
t = open("namelist.wps").read()
geo = re.search(r"opt_output_from_geogrid_path\s*=\s*'([^']*)'", t).group(1)
pfx = re.search(r"fg_name\s*=\s*'([^']*)'", t).group(1)
s, e = (datetime.strptime(re.search(rf"{k}\s*=\s*'([^']+)'", t).group(1), "%Y-%m-%d_%H:%M:%S") for k in ("start_date", "end_date"))
x = s
while x <= e:
    f = f"{pfx}:{x:%Y-%m-%d_%H}"
    assert glob.glob(f), f"missing intermediate file {f}"
    for d in (1, 2):
        assert glob.glob(f"{geo}/geo_em.d0{d}.nc"), "no geo_em"
        xr.Dataset({"TT": (("Time", "num_metgrid_levels", "south_north", "west_east"), np.zeros((1, 38, 2, 2), "f4"))}).to_netcdf(
            f"met_em.d0{d}.{x:%Y-%m-%d_%H:%M:%S}.nc")
    x += timedelta(hours=3)
print("!  Successful completion of metgrid.        !")
