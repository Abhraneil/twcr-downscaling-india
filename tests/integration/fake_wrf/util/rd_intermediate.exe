#!/usr/bin/env python3
# reads the file with the repository's own reader (a format error fails here, as in WPS)
import sys
from pathlib import Path
sys.path.insert(0, str(Path(__file__).resolve().parents[4] / "scripts" / "preprocess"))
sys.path.insert(0, str(Path(__file__).resolve().parents[4] / "scripts"))
from to_wps import read_intermediate
for r in read_intermediate(sys.argv[1]):
    print(f"FIELD = {r['field']}  LEVEL = {r['xlvl']}")
